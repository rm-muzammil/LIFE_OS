# Neon Postgres connection string
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Optional — secures the /api/cron/pull-provinces endpoint.
# If set, Vercel Cron will automatically send this as a Bearer token.
CRON_SECRET=""

# Required — Google OAuth (see README for setup steps)
NEXTAUTH_URL="https://self-khilafah.vercel.app"
NEXTAUTH_SECRET=""  # generate with: openssl rand -base64 32
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Required for /api/cron/generate-schedule to work in multi-user mode.
# Authenticates the server-to-server call from that cron route into
# /api/scheduler/generate on behalf of each user. Without this set, the
# manual "Regenerate" button on /schedule still works (it uses your signed-in
# session instead), but the daily cron-triggered generation will 401.
SCHEDULER_API_SECRET=""

# Optional — shared fallback Gemini keys, used for any user who hasn't set
# their own keys on the Settings page (Settings > Gemini API Keys).
GEMINI_API_KEY_1=""
GEMINI_API_KEY_2=""
GEMINI_API_KEY_3=""

# Required — the one shared secret every province app sends when pushing data.
# Province apps no longer get individual per-user keys; they all use this
# same value and identify whose data it is via a `userId` field in the push
# body (see README > "Provinces: shared key architecture").
PROVINCE_SHARED_API_KEY=""  # generate with: openssl rand -hex 32

